---
import BackToTop from "@components/BackToTop.astro";
import siteConfig from "@lib/site-config";

const { footer, footerLinks } = siteConfig;
const sinceYear = new Date(footer.since).getFullYear();
---

<footer class="site-footer">
  <div class="footer-row">
    <span>© {sinceYear}–{new Date().getFullYear()} {footer.author}</span>
    <a href={footer.icpUrl}>{footer.icp}</a>
    <a href={footer.cdnUrl}>{footer.cdnNote}</a>
  </div>

  {footer.showRuntime && (
    <div class="footer-row footer-stats">
      <span id="site-runtime">本站已运行 …</span>
      {footer.showVisitor && (
        <>
          <span id="busuanzi_container_site_uv">访客数 <span id="busuanzi_value_site_uv"></span> 人</span>
          <span id="busuanzi_container_site_pv">总访问量 <span id="busuanzi_value_site_pv"></span> 次</span>
        </>
      )}
    </div>
  )}

  <div class="footer-row">
    {footerLinks.map((link) => (
      <a href={link.href}>{link.label}</a>
    ))}
  </div>

  <BackToTop />
</footer>

{footer.showRuntime && (
  <script define:vars={{ since: footer.since }}>
    (() => {
      const updateRuntime = () => {
        const el = document.getElementById("site-runtime");
        if (!el) return;
        const start = new Date(since);
        const days = Math.floor((Date.now() - start.getTime()) / 86400000);
        const y = Math.floor(days / 365);
        const d = days % 365;
        el.textContent = `本站已运行 ${y} 年 ${d} 天`;
      };
      updateRuntime();
      document.addEventListener("astro:after-swap", updateRuntime);
    })();
  </script>
)}

{footer.showVisitor && (
  <script is:inline>
    (() => {
      const fetchCount = () => {
        const cb = "BusuanziCallback_" + Math.floor(1e12 * Math.random());
        window[cb] = (data) => {
          try {
            const uv = document.getElementById("busuanzi_value_site_uv");
            const pv = document.getElementById("busuanzi_value_site_pv");
            if (uv && data.site_uv) uv.textContent = data.site_uv;
            if (pv && data.site_pv) pv.textContent = data.site_pv;
          } catch (e) {}
          try { delete window[cb]; } catch (e) {}
        };
        const s = document.createElement("script");
        s.src = "//busuanzi.ibruce.info/busuanzi?jsonpCallback=" + cb;
        s.async = true;
        document.head.appendChild(s);
      };
      fetchCount();
      document.addEventListener("astro:after-swap", fetchCount);
    })();
  </script>
)}


