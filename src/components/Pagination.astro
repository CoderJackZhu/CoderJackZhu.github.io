---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";

type Props = {
  page: Page<CollectionEntry<"blog">>;
};

const { page } = Astro.props;
const prevHref = page.currentPage === 2 ? "/blog/" : page.url.prev;
---

<nav class="pagination">
  {prevHref ? <a href={prevHref}>上一页</a> : <span></span>}
  <span class="page-info">第 {page.currentPage} / {page.lastPage} 页</span>
  {page.url.next ? <a href={page.url.next}>下一页</a> : <span></span>}
</nav>
