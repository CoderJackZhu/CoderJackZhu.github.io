---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import BackToPrevious from "@components/BackToPrevious.astro";
import { SITE } from "@consts";
import siteConfig from "@lib/site-config";

const notFoundCopy = siteConfig.pages.notFound;
---

<Layout title={notFoundCopy.title} description={SITE.DESCRIPTION}>
  <Container>
    <div class="archive-head">
      <p class="eyebrow">{notFoundCopy.eyebrow}</p>
      <h1>{notFoundCopy.heading}</h1>
      <p><BackToPrevious href="/">返回首页</BackToPrevious></p>
    </div>
  </Container>
</Layout>
