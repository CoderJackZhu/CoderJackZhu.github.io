---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { SITE, SOCIALS } from "@consts";
import siteConfig from "@lib/site-config";

const aboutCopy = siteConfig.pages.about;
---

<Layout title={aboutCopy.title} description={SITE.DESCRIPTION}>
  <Container>
    <div class="animate">
      <header class="about-head">
        <p class="eyebrow">{aboutCopy.eyebrow}</p>
        <h1>{aboutCopy.heading}</h1>
        <p>{aboutCopy.subtitle}</p>
      </header>
      <div class="about-grid">
        <div class="about-copy">
          {siteConfig.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <dl class="about-note">
          <dt>站点</dt>
          <dd>jackzhu.top</dd>
          <dt>订阅</dt>
          <dd>RSS / Atom</dd>
          <dt>社交</dt>
          <dd>
            {
              SOCIALS.map((social, index) => (
                <span>
                  {index > 0 && " · "}
                  <a
                    href={social.HREF}
                    target={social.HREF.startsWith("http") ? "_blank" : "_self"}
                    rel={social.HREF.startsWith("http") ? "noopener noreferrer" : undefined}
                  >
                    {social.NAME}
                  </a>
                </span>
              ))
            }
          </dd>
        </dl>
      </div>
    </div>
  </Container>
</Layout>
